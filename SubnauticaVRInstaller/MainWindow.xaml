<Window Icon="app.ico" x:Class="SubnauticaVRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SUBNAUTICA VR - Installateur SubmersedVR 6DOF &amp; DLSS (Édition Française) • LordMadTrix"
        Height="720" Width="850" MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#020B14"
        Foreground="#E0F7FA"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BeaconOrange" Color="#FF8C00" />
        <SolidColorBrush x:Key="OceanCyan" Color="#00E5FF" />
        <SolidColorBrush x:Key="CardBg" Color="#061628" />
        <SolidColorBrush x:Key="CardBorder" Color="#0F3050" />

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CyanButton" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF" />
            <Setter Property="Foreground" Value="#01101E" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33EFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#00B8CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource CyanButton}">
            <Setter Property="Background" Value="#FF8C00" />
            <Setter Property="Foreground" Value="#1A0D00" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFA233" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#CC7000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#092038" />
            <Setter Property="Foreground" Value="#00E5FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#15406B" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#031020" BorderBrush="#0F3050" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌊 SUBNAUTICA VR" FontSize="20" FontWeight="Black" Foreground="#00E5FF" />
                        <Border Background="#FF8C00" CornerRadius="4" Padding="7,2" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SUBMERSEDVR 6DOF" FontSize="10" FontWeight="Bold" Foreground="#120700" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Exploration Sous-Marine 4546B, Mains 6DOF, Scanner Virtuel &amp; Véhicules" FontSize="12" Foreground="#80DEEA" Margin="0,3,0,0" />
                    <TextBlock x:Name="TxtGpuInfo" Text="🔍 Détection GPU..." FontSize="11" Foreground="#00E5FF" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#07203A" BorderBrush="#144A7E" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="✍ Signé LordMadTrix" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                </Border>
            </Grid>
        </Border>

        <!-- Corps principal -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,14,0">
            <StackPanel>

                <!-- Carte : Aperçu visuel en jeu -->
                <Border Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True">
                    <Grid Height="140">
                        <Image Source="assets/vr_preview.png" Stretch="UniformToFill" />
                        <Border Background="#99020B14" VerticalAlignment="Bottom" Padding="12,6">
                            <TextBlock Text="👁️ Aperçu Vue Casque VR : Plongée 6DOF, gants de plongée virtuels &amp; récif bioluminescent" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Carte : Répertoire de jeu -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="📁 DOSSIER DU JEU (SUBNAUTICA)" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGamePath" Grid.Column="0" Background="#030E1A" Foreground="#E0F7FA" BorderBrush="#0F3050" BorderThickness="1" Padding="8,6" FontSize="12" TextChanged="TxtGamePath_TextChanged" />
                            <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="BtnBrowse_Click" />
                            <Button Grid.Column="2" Content="📂 Ouvrir" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="BtnOpenFolder_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtDetectStatus" Text="🔍 Recherche de Subnautica.exe..." FontSize="11" Foreground="#26C6DA" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Carte : DLSS & Upscaling IA -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="⚡ UPSCALING IA &amp; SUPER-RÉSOLUTION SUBMERSED" FontWeight="Bold" FontSize="12" Foreground="#FF8C00" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkDlss" Content="Activer Upscaling IA OpenXR Haute Netteté (FSR 3 / DLSS VR pour eaux cristallines)" IsChecked="True" Foreground="#E0F7FA" Margin="0,2,0,4" />
                        <CheckBox x:Name="ChkAnisotropic" Content="Filtrage anisotrope 16x &amp; amélioration des fonds marins 6DOF" IsChecked="True" Foreground="#E0F7FA" Margin="0,2,0,4" />
                    </StackPanel>
                </Border>

                <!-- Carte : Casque VR -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🥽 CASQUE VR DÉTECTÉ :" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border x:Name="BadgeCasque" Grid.Column="1" Background="#0A2A48" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtCasqueBadge" Text="❌ Aucun client VR détecté" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B" />
                            </Border>
                        </Grid>
                        <CheckBox x:Name="ChkQuest3Opt" Content="Optimisation Quest 3 (Wi-Fi 6, 120Hz, Buffer fluide Seamoth/Cyclops)" IsChecked="True" Foreground="#FF8C00" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Carte : Profils & Immersion -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="🎛️ PROFILS IMMERSIFS SUBMERSEDVR" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioNormal" Grid.Column="0" Content="90 FPS Équilibré" Foreground="#E0F7FA" Margin="2" />
                            <RadioButton x:Name="RadioQuest3" Grid.Column="1" Content="120 FPS Quest 3 (Recommandé)" IsChecked="True" Foreground="#E0F7FA" Margin="2" />
                            <RadioButton x:Name="RadioUltra" Grid.Column="2" Content="Ultra Natif 100%" Foreground="#E0F7FA" Margin="2" />
                        </Grid>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="Créer le raccourci Bureau 'Subnautica VR (FR)'" IsChecked="True" Foreground="#E0F7FA" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Console de déploiement -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="📋 CONSOLE DE DÉPLOIEMENT" FontWeight="Bold" FontSize="11" Foreground="#80DEEA" Margin="0,0,0,4" />
                        <ProgressBar x:Name="ProgressBar" Height="6" Background="#030E1A" Foreground="#00E5FF" BorderBrush="#0F3050" Margin="0,0,0,6" />
                        <ListBox x:Name="LogConsole" Height="90" Background="#01070F" BorderBrush="#0F3050" RequestBringIntoView="LogConsole_RequestBringIntoView" FontSize="11" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <Border Grid.Row="2" Background="#020B14" BorderBrush="#0F3050" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnInstall" Grid.Column="0" Content="⚡ INSTALLER SUBMERSEDVR 6DOF" Style="{StaticResource CyanButton}" Margin="0,0,8,0" Click="BtnInstall_Click" />
                <Button x:Name="BtnLaunch" Grid.Column="1" Content="🚀 LANCER EN VR" Style="{StaticResource OrangeButton}" Padding="16,10" Margin="0,0,8,0" Click="BtnLaunch_Click" />
                <Button x:Name="BtnUninstall" Grid.Column="2" Content="Restaurer Vanilla" Style="{StaticResource DarkButton}" Click="BtnUninstall_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
